# Copy to .env and fill in your own values. docker-compose.yml reads this
# file automatically. Nothing here gets baked into the image (see Dockerfile
# / docker/profiles.yml.template) -- it's only ever passed at container run
# time.

# Your Databricks workspace, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=

# A personal access token (Settings -> Developer -> Access tokens in the
# Databricks UI, long-lived) works fine here, or a token minted via
# `databricks auth token --profile <profile>` (short-lived, ~1hr, if your
# workspace uses OAuth login instead of a static PAT). If you're using the
# latter, run docker/refresh_token.sh on your HOST machine whenever an
# agent run or the Streamlit UI reports a DatabricksAuthError, then restart
# the container -- much less friction than copy-pasting the token by hand.
DATABRICKS_TOKEN=

# SQL Warehouse ID -- the segment after /warehouses/ in
# Databricks UI -> SQL Warehouses -> (your warehouse) -> Connection details.
DATABRICKS_WAREHOUSE_ID=

# Optional -- Unity Catalog catalog name to use. Defaults to dbt_migration
# if left blank; the catalog itself must already exist (Preflight creates
# the audit schema/tables inside it, not the catalog).
DBT_MIGRATION_CATALOG=

# Path on THIS machine to the Snowflake+dbt project you want to migrate --
# bind-mounted read/write into the container at the fixed path /data/project
# (pre-filled automatically in the Streamlit UI's Project path field).
PROJECT_PATH=
