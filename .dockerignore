# Generated at runtime by the agents — regenerated on every run, not hand-
# written source. Should be volume-mounted for persistence, not baked into
# the image. Mirrors ../.gitignore for the same reasons.
migration-workspace/
output_databricks/
reports/

__pycache__/
*.pyc
.git/
.claude/

# Real credentials — read by docker-compose on the HOST for env var
# interpolation, never meant to enter the image itself. Baking this in
# would embed a live token in a permanent, inspectable image layer.
.env

# Pre-agent manual-exploration debug artifacts, not part of the tool.
trash/

# Project docs -- for developers reading the repo, not read by any agent at
# runtime (confirmed: no code opens/reads a .md file). No reason to ship
# them in the image.
*.md
